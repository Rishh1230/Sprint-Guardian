# Sprint Guardian — Environment Variables
# Copy this file to .env and fill in your values.
# These variables are optional shortcuts; all can also be passed as CLI flags.

# ── Jira / Board Config ────────────────────────────────────────────────────────
# Default Jira board ID (overridden by --board-id)
SPRINT_ASSIGNER_BOARD_ID=

# Default Jira project key(s), comma-separated (overridden by --project-key)
SPRINT_ASSIGNER_PROJECT_KEYS=PROJ

# Default sprint ID (overridden by --sprint-id)
SPRINT_ASSIGNER_SPRINT_ID=

# Default sprint name (overridden by --sprint-name)
SPRINT_ASSIGNER_SPRINT_NAME=

# ── Team Map ───────────────────────────────────────────────────────────────────
# Path to your configured team map YAML (overridden by --team-map)
SPRINT_ASSIGNER_TEAM_MAP=references/team-map.local.yaml

# ── Approval & Governance ─────────────────────────────────────────────────────
# Default approval authority name (overridden by --approved-by)
# Leave empty to require explicit --approved-by on every apply run.
SPRINT_ASSIGNER_APPROVED_BY=

# Optional human approval note appended to audit log entries
SPRINT_ASSIGNER_APPROVAL_NOTE=

# ── Codex Runtime ─────────────────────────────────────────────────────────────
# Codex model to use (e.g. o4-mini, gpt-4o). Leave empty to use Codex default.
CODEX_MODEL=

# Working directory passed to codex exec. Leave empty to use current directory.
CODEX_WORKDIR=

# ── Output ────────────────────────────────────────────────────────────────────
# Custom path for previous progress-pulse snapshot (auto-detected if empty)
SPRINT_ASSIGNER_PREVIOUS_SNAPSHOT=
